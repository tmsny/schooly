rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function member(){return signedIn() && request.auth.uid in resource.data.memberIds;}
  function owner(){return signedIn() && request.auth.uid == resource.data.ownerId;}
  match /users/{uid}/private/{doc} { allow read,delete: if signedIn() && request.auth.uid == uid; allow create,update: if signedIn() && request.auth.uid == uid && doc == 'main' && request.resource.data.keys().hasOnly(['state','updatedAt','schemaVersion']); }
  match /classDirectory/{code} { allow get: if signedIn(); allow list: if false; allow create: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{8}$') && request.resource.data.keys().hasOnly(['classId','name','createdAt']) && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 70; allow update,delete: if false; }
  match /classes/{id} { allow get,list: if member(); allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.memberIds == [request.auth.uid] && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 70 && request.resource.data.code.matches('^[A-HJ-NP-Z2-9]{8}$') && request.resource.data.keys().hasOnly(['name','code','ownerId','ownerName','memberIds','createdAt']); allow update: if signedIn() && ((owner() && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.code == resource.data.code && request.resource.data.memberIds == resource.data.memberIds && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','ownerName'])) || (request.resource.data.ownerId == resource.data.ownerId && request.resource.data.code == resource.data.code && request.resource.data.name == resource.data.name && request.resource.data.memberIds is list && request.auth.uid in request.resource.data.memberIds && request.resource.data.memberIds.hasAll(resource.data.memberIds) && request.resource.data.memberIds.size() == resource.data.memberIds.size()+1 && get(/databases/$(database)/documents/classDirectory/$(resource.data.code)).data.classId == id)); allow delete: if owner(); }
 }
}